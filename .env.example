# =============================================================================
# LLM
# =============================================================================
DASHSCOPE_API_KEY=
OPENAI_API_KEY=
LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus
INTERVIEW_REPORT_MODEL=qwen-plus

# =============================================================================
# Runtime
#
# LISTEN_PORT：应用内部监听端口（默认 5001）
#   本地开发时直接访问 http://localhost:5001/interview.html
#   生产环境通过 Nginx 反向代理对外暴露 HTTPS 端口（如 8010）
# =============================================================================
TRANSPORT=webrtc
HUMAN_MODEL=wav2lip
AVATAR_ID=wav2lip_avatar_atlas
ENGLISH_AVATAR_ID=wav2lip_avatar_atlas5_en_v1
LISTEN_PORT=5001
MAX_SESSION=1

# =============================================================================
# TTS
# =============================================================================
TTS_BACKEND=tencent
TTS_REF_FILE=603005
TTS_REF_TEXT=
TTS_SERVER=http://127.0.0.1:9880
ENGLISH_TTS_BACKEND=tencent
ENGLISH_TTS_REF_FILE=502001
ENGLISH_TTS_REF_TEXT=

# Azure TTS
AZURE_SPEECH_KEY=
AZURE_TTS_REGION=

# Tencent TTS（同时也用于腾讯云短信鉴权）
TENCENT_APPID=
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=

# Doubao TTS
DOUBAO_APPID=
DOUBAO_TOKEN=

# =============================================================================
# Auth / JWT
# 生成强随机密钥命令：
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# =============================================================================
JWT_SECRET=change-me-to-a-random-string

# =============================================================================
# 腾讯云短信验证码
#
# SMS_DEV_MODE=true  -> 不真实发送，验证码只打印到服务器日志（开发/测试用）
# SMS_DEV_MODE=false -> 真实发送（上线必须设为 false）
# =============================================================================
SMS_DEV_MODE=true

# TENCENT_SECRET_ID / TENCENT_SECRET_KEY 与上面 TTS 部分共用，无需重复填写
# TENCENT_SMS_APPID：在腾讯云短信控制台创建应用后获得（格式 14xxxxxxxx，≠ TTS APPID）
TENCENT_SMS_APPID=
# 短信签名（需在控制台申请审核通过）
TENCENT_SMS_SIGN_NAME=
# 验证码短信模板 ID（需在控制台申请审核通过，模板示例：您的验证码为{1}，{2}分钟内有效）
TENCENT_SMS_TEMPLATE_ID=

# =============================================================================
# 微信支付 Native 扫码支付（可选，不配置则支付功能不可用）
# =============================================================================
WECHAT_MCH_ID=
WECHAT_APP_ID=
WECHAT_API_KEY=
WECHAT_NOTIFY_URL=
WECHAT_PRIVATE_KEY_PATH=
WECHAT_CERT_SERIAL_NO=
