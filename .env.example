# =============================================================================
# LLM
# =============================================================================
DASHSCOPE_API_KEY=
OPENAI_API_KEY=
LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus
INTERVIEW_REPORT_MODEL=qwen-plus

# =============================================================================
# Runtime
# =============================================================================
TRANSPORT=webrtc
HUMAN_MODEL=wav2lip
AVATAR_ID=wav2lip_avatar_atlas
ENGLISH_AVATAR_ID=wav2lip_avatar_atlas5_en_v1
LISTEN_PORT=8010
MAX_SESSION=1

# =============================================================================
# TTS
# =============================================================================
TTS_BACKEND=tencent
TTS_REF_FILE=602004
TTS_REF_TEXT=
TTS_SERVER=http://127.0.0.1:9880
ENGLISH_TTS_BACKEND=tencent
ENGLISH_TTS_REF_FILE=502001
ENGLISH_TTS_REF_TEXT=

# Azure TTS
AZURE_SPEECH_KEY=
AZURE_TTS_REGION=

# Tencent TTS（同时也用于腾讯云短信鉴权）
TENCENT_APPID=
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=

# Doubao TTS
DOUBAO_APPID=
DOUBAO_TOKEN=

# =============================================================================
# Auth / JWT
# 生成强随机密钥命令：
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# =============================================================================
JWT_SECRET=change-me-to-a-random-string

# =============================================================================
# SMS 验证码短信
#
# SMS_DEV_MODE=true  -> 不真实发送，验证码只打印到服务器日志（开发/测试用）
# SMS_DEV_MODE=false -> 真实发送（上线必须设为 false）
#
# AUTH_CHANNEL：验证渠道
#   email（默认） -> 用邮箱验证码，无需营业执照，个人 QQ邮箱/163 即可
#   sms           -> 用手机短信，需要向云厂商申请（需营业执照）
# =============================================================================
SMS_DEV_MODE=true
AUTH_CHANNEL=email

# =============================================================================
# 邮箱 SMTP 配置（AUTH_CHANNEL=email 时生效）
#
# 常用服务商配置：
#   QQ邮箱：SMTP_HOST=smtp.qq.com  SMTP_PORT=587  SMTP_PASS=QQ邮箱授权码
#   163邮箱：SMTP_HOST=smtp.163.com SMTP_PORT=587  SMTP_PASS=163邮箱授权码
#   Gmail：  SMTP_HOST=smtp.gmail.com SMTP_PORT=587 SMTP_PASS=应用专用密码
#
# QQ邮箱授权码获取：QQ邮箱 -> 设置 -> 账户 -> 开启SMTP -> 生成授权码
# =============================================================================
SMTP_HOST=smtp.qq.com
SMTP_PORT=587
SMTP_USER=your-email@qq.com
SMTP_PASS=your-smtp-authorization-code
SMTP_FROM_NAME=乔治面试
EMAIL_SUBJECT=【乔治面试】您的登录验证码

# SMS（AUTH_CHANNEL=sms 时生效）
SMS_BACKEND=tencent

# --- 腾讯云短信（SMS_BACKEND=tencent 时生效）---
# TENCENT_SECRET_ID / TENCENT_SECRET_KEY 与上面 TTS 部分共用，无需重复填写
# TENCENT_SMS_APPID：在腾讯云短信控制台创建应用后获得（格式 14xxxxxxxx，≠ TTS APPID）
TENCENT_SMS_APPID=
# 短信签名（需在控制台申请审核通过）
TENCENT_SMS_SIGN_NAME=
# 验证码短信模板 ID（需在控制台申请审核通过，模板示例：您的验证码为{1}，{2}分钟内有效）
TENCENT_SMS_TEMPLATE_ID=

# --- 阿里云短信（SMS_BACKEND=aliyun 时生效）---
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
# 短信签名名称（需在控制台申请审核通过）
ALIYUN_SMS_SIGN_NAME=
# 短信模板 CODE（例：SMS_123456789，模板示例：验证码${code}，5分钟内有效）
ALIYUN_SMS_TEMPLATE_CODE=

# =============================================================================
# 支付宝当面付（扫码支付）
# 个人支付宝账号即可接入，无需营业执照
# 申请地址：https://open.alipay.com/
#
# ALIPAY_SANDBOX=true  -> 沙箱环境（开发测试，不扣真实钱）
# ALIPAY_SANDBOX=false -> 正式环境（上线必须设为 false）
# =============================================================================
ALIPAY_SANDBOX=true
# 应用 ID，在支付宝开放平台创建应用后获得（正式应用格式 2021xxxxx）
ALIPAY_APP_ID=
# 应用 RSA2 私钥文件路径（本地生成，不要上传到 Git）
ALIPAY_PRIVATE_KEY_PATH=/path/to/alipay_private_key.pem
# 支付宝公钥文件路径（从开放平台「接口加签方式」页面获取粘贴后保存）
ALIPAY_PUBLIC_KEY_PATH=/path/to/alipay_public_key.pem
# 异步回调地址，必须是 HTTPS
ALIPAY_NOTIFY_URL=https://your-domain.com/pay/notify
