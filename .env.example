# LLM
DASHSCOPE_API_KEY=
OPENAI_API_KEY=
LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus
INTERVIEW_REVIEW_MODEL=qwen-turbo-latest
INTERVIEW_REVIEW_START_AFTER_SECONDS=600
INTERVIEW_REPORT_MODEL=qwen-plus

# Runtime
TRANSPORT=webrtc
HUMAN_MODEL=wav2lip
AVATAR_ID=wav2lip_avatar_atlas
ENGLISH_AVATAR_ID=wav2lip_avatar_atlas5_en_v1
LISTEN_PORT=8010
MAX_SESSION=1

# TTS
TTS_BACKEND=tencent
TTS_REF_FILE=602004
TTS_REF_TEXT=
TTS_SERVER=http://127.0.0.1:9880
ENGLISH_TTS_BACKEND=tencent
ENGLISH_TTS_REF_FILE=502001
ENGLISH_TTS_REF_TEXT=

# Azure TTS
AZURE_SPEECH_KEY=
AZURE_TTS_REGION=

# Tencent TTS
TENCENT_APPID=
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=

# Doubao TTS
DOUBAO_APPID=
DOUBAO_TOKEN=

# Auth / JWT
JWT_SECRET=change-me-to-a-random-string

# WeChat Pay (微信支付 Native 扫码支付)
WECHAT_MCH_ID=
WECHAT_APP_ID=
WECHAT_API_KEY=
